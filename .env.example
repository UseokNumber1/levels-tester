# =============================================================================
# Levels Tester: переменные окружения
# Скопируйте этот файл в .env — значения читаются при старте приложения.
# Секреты хранятся только здесь; в Git файл .env не попадает (.gitignore).
# =============================================================================

# Окружение приложения: development | production.
APP_ENV=development

# Адрес и порт веб-сервера. По умолчанию сервер слушает localhost.
APP_HOST=127.0.0.1
APP_PORT=8000

# -----------------------------------------------------------------------------
# Подключение к SQL (SQLAlchemy URL).
#
# Основной вариант — локальный сервер MariaDB. База хранится в каталогах
# сервера (data dir), создаётся один раз скриптом:
#   powershell -ExecutionPolicy Bypass -File scripts\init_mariadb.ps1
# Пароль пользователя level_tester должен совпадать с паролем в URL ниже.
# Используйте только латиницу/цифры без пробелов; символы @ : / # ? % нужно
# URL-кодировать (например, "p@ss:word" -> "p%40ss%3Aword").
# ВАЖНО: скрипт создаёт пользователя с mysql_native_password — драйвер
# pymysql не поддерживает GSSAPI-плагин, который MariaDB 11.8 на Windows
# запрашивает по умолчанию.
#
DATABASE_URL=mysql+pymysql://level_tester:LtLocal2026@127.0.0.1:3306/level_tester
#
# Правила пароля в URL:
# - символы @ : / # ? % URL-кодируются: "p@ss:word" -> "p%40ss%3Aword";
# - кодировка базы utf8mb4 задаётся скриптом инициализации;
# - приложение само переводит каждую SQL-сессию в UTC (+00:00);
# - таблицы и индексы создаются автоматически при старте, если их нет;
#   проверка структуры: GET /api/status -> database_schema.
#
# Резервный вариант без сервера (файл в корне проекта):
# DATABASE_URL=sqlite:///./levels_tester.db
# -----------------------------------------------------------------------------

# Базовый URL публичного Binance Futures API.
# Меняется только для тестовых прокси/зеркал; ключи API не требуются.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
